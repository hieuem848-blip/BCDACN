PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB Atlas: Connect > Drivers > copy chuỗi kết nối, thêm tên database (ví dụ /hotel_booking)
MONGODB_URI=your_mongodb_connection_string
JWT_SECRET=replace_with_a_long_random_secret

# Đăng nhập Google: Google Cloud Console > Credentials > OAuth client ID (Web)
GOOGLE_CLIENT_ID=

# Đăng nhập Facebook: developers.facebook.com > Settings > Basic
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Gửi mã OTP qua email (Gmail: bật xác minh 2 bước rồi tạo "Mật khẩu ứng dụng" 16 ký tự)
# Để trống thì mã OTP được in ra terminal của server (chỉ dùng khi phát triển)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# SePay Sandbox (lấy MERCHANT ID và SECRET KEY từ SePay Merchant Portal)
SEPAY_MERCHANT_ID=
SEPAY_SECRET_KEY=
# Secret Key riêng ở cấu hình IPN trên SePay; phải trùng X-Secret-Key gửi về Backend
SEPAY_IPN_SECRET=
SEPAY_CHECKOUT_URL=https://pay-sandbox.sepay.vn/v1/checkout/init

# ZaloPay Sandbox (điền App ID, Key1, Key2 do ZaloPay cấp hoặc bộ test chính thức)
ZALOPAY_APP_ID=
ZALOPAY_KEY1=
ZALOPAY_KEY2=
ZALOPAY_CALLBACK_URL=
ZALOPAY_CREATE_URL=https://sb-openapi.zalopay.vn/v2/create
